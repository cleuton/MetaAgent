name: release

on:
  push:
    tags: ["v*"]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: ubuntu-22.04
            name: linux-amd64
            exe: metagente
          - os: macos-14          # Apple Silicon (arm64)
            name: macos-arm64
            exe: metagente
          - os: windows-latest
            name: windows-amd64
            exe: metagente.exe
    runs-on: ${{ matrix.os }}
    defaults:
      run:
        shell: bash
    steps:
      - uses: actions/checkout@v4

      - uses: dtolnay/rust-toolchain@stable

      - uses: Swatinem/rust-cache@v2

      - name: Build
        run: cargo build --release

      - name: Package
        run: |
          VERSION="v$(grep -m1 '^version' Cargo.toml | cut -d '"' -f2)"
          D=dist/metagente
          mkdir -p $D/bin $D/docs $D/samples
          cp target/release/${{ matrix.exe }} $D/bin/
          cp metagente.toml $D/
          cp README.md $D/docs/README.md
          cp docs/guide.md docs/syntax.md docs/tutorial.md $D/docs/
          cp examples/clock.ag examples/read_file.ag examples/weather.ag \
             examples/planner.ag examples/remote_weather.ag $D/samples/
          cat > $D/README.md <<EOF
          # Metagente $VERSION (${{ matrix.name }})

          Run a sample from this folder:

              ./bin/metagente run samples/clock.ag now        (Linux, macOS)
              .\bin\metagente.exe run samples\clock.ag now    (Windows)

          More: docs/tutorial.md. Repository: https://github.com/cleuton/MetaAgent
          EOF
          cd dist
          if [ "${{ runner.os }}" = "Windows" ]; then
            7z a -tzip metagente-${{ matrix.name }}.zip metagente
          else
            zip -r -D -X metagente-${{ matrix.name }}.zip metagente
          fi

      - uses: actions/upload-artifact@v4
        with:
          name: metagente-${{ matrix.name }}
          path: dist/metagente-${{ matrix.name }}.zip

  release:
    needs: build
    runs-on: ubuntu-latest
    if: startsWith(github.ref, 'refs/tags/v')
    steps:
      - uses: actions/download-artifact@v4
        with:
          path: zips
          merge-multiple: true
      - uses: softprops/action-gh-release@v2
        with:
          files: zips/*.zip
          generate_release_notes: true